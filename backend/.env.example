PORT=3000
NODE_ENV=development

# Google Cloud
GOOGLE_CLOUD_API_KEY=

# Groq chatbot (Roleplay mode) — primary provider for /api/chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter chatbot (Roleplay mode) — secondary provider for /api/chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Gemini chatbot (Roleplay mode) — fallback provider for /api/chat
GEMINI_MODEL=gemini-flash-latest

# Chat provider: unset = Groq, then OpenRouter, then Gemini; or pin "groq" / "openrouter" / "gemini"
# CHAT_PROVIDER=groq

# Firebase
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Auth
JWT_SECRET=change-me

# CORS
FRONTEND_ORIGIN=http://localhost:5173